{
  "expo": {
    "name": "See",
    "slug": "see",
    "scheme": "see",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/see-dino-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-calendar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131313",
          "image": "./assets/see-dino-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed15e83e-514e-4a1a-b1b9-049653548bd4"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.nife.dev.see",
      "versionCode": 5,
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/see-dino-adaptive.png",
        "backgroundColor": "#070d0d"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nife.dev.see",
      "buildNumber": "1",
      "infoPlist": {
        "NSCalendarsUsageDescription": "See needs calendar access to sync events",
        "NSContactsUsageDescription": "See needs contacts access for job prospects",
        "UIRequiredDeviceCapabilities": [
          "armv7"
        ]
      }
    }
  }
}
